{
  "__inputs": [],
  "__requires": [],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "schemaVersion": 38,
  "style": "dark",
  "tags": [],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "LLM Inference & JVM Metrics",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 11,
      "targets": [
        {
          "expr": "sum(rate(inference_pipe_ttft_seconds_sum[1m])) by (protocol) / sum(rate(inference_pipe_ttft_seconds_count[1m])) by (protocol)",
          "legendFormat": "Avg TTFT - {{protocol}}",
          "refId": "A"
        },
        {
          "expr": "inference_pipe_ttft_seconds_max",
          "legendFormat": "Max TTFT - {{protocol}}",
          "refId": "B"
        }
      ],
      "title": "Time to First Token (TTFT) Comparison",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 12,
      "targets": [
        {
          "expr": "sum(http_server_requests_active_seconds_count{uri=\"UNKNOWN\"})",
          "legendFormat": "Active REST Streams",
          "refId": "A"
        },
        {
          "expr": "sum(rate(inference_pipe_serialization_overhead_seconds_count[1m])) by (protocol)",
          "legendFormat": "Active gRPC Requests/Sec",
          "refId": "B"
        }
      ],
      "title": "Active Streaming Streams (Target: 5,000)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        }
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 13,
      "targets": [
        {
          "expr": "sum(rate(jvm_gc_memory_allocated_bytes_total[1m]))",
          "legendFormat": "JVM Memory Allocation Rate / Sec",
          "refId": "A"
        },
        {
          "expr": "sum(rate(jvm_gc_memory_promoted_bytes_total[1m]))",
          "legendFormat": "Old Gen Promotion Rate / Sec",
          "refId": "B"
        }
      ],
      "title": "GC Allocation & Promotion Pressure (8k Token Chunking Footprint)",
      "type": "timeseries"
    }
  ]
}